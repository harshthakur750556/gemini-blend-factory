    { indices: [3, 2, 6, 7], part: 'chassis' },
    { indices: [0, 4, 11, 12], part: 'weapons' },
    { indices: [11, 12, 13], part: 'weapons' },
    { indices: [11, 13, 17], part: 'weapons', isBarrel: true },
    { indices: [1, 5, 14, 15], part: 'weapons' },
    { indices: [14, 15, 16], part: 'weapons' },
    { indices: [14, 16, 18], part: 'weapons', isBarrel: true },
    { indices: [3, 7, 21, 19], part: 'hydraulics' },
    { indices: [2, 6, 21, 20], part: 'hydraulics' },
    { indices: [19, 21, 22], part: 'legs' },
    { indices: [22, 24, 25], part: 'legs', isFoot: true },
    { indices: [20, 21, 23], part: 'legs' },
    { indices: [23, 26, 27], part: 'legs', isFoot: true }
  ];

  function projectPoint(point, width, height, scale, rX, rY, pX, pY) {
    const radX = (rX * Math.PI) / 180;
    const radY = (rY * Math.PI) / 180;

    const cosY = Math.cos(radY);
    const sinY = Math.sin(radY);
    const x1 = point.x * cosY - point.z * sinY;
    const z1 = point.x * sinY + point.z * cosY;

    const cosX = Math.cos(radX);
    const sinX = Math.sin(radX);
    const y2 = point.y * cosX - z1 * sinX;
    const z2 = point.y * sinX + z1 * cosX;

    const cameraDist = 3.6;
    const fovFactor = cameraDist / (cameraDist + z2);
    const projScale = scale * fovFactor;

    return {
      x: width / 2 + x1 * projScale + pX,
      y: height / 2 + y2 * projScale + pY,
      z: z2,
      rawX: x1,
      rawY: y2,
      rawZ: z2
    };
  }

  // Draw Authentic Blender 3D Ground Plane Grid with Axis Lines, Subdivisions, Circular Falloff & Contact Shadow
  function drawPerspectiveGrid(context, w, h, rX, rY, scale, pX, pY) {
    context.save();
    const gridY = 1.9; // Base ground height beneath the mech's feet
    const gridLimit = 7.0; // Outer grid boundary in 3D units
    const centerPt = projectPoint({ x: 0, y: gridY, z: 0 }, w, h, scale, rX, rY, pX, pY);

    // 1. Subtle Blender Contact Shadow Catcher underneath mech contact points
    const shadowRadX = scale * 1.05;
    const shadowRadY = scale * 0.28;
    const shadowGrad = context.createRadialGradient(centerPt.x, centerPt.y, 4, centerPt.x, centerPt.y, shadowRadX);
    shadowGrad.addColorStop(0, 'rgba(15, 23, 42, 0.28)');
    shadowGrad.addColorStop(0.35, 'rgba(30, 41, 59, 0.14)');
    shadowGrad.addColorStop(0.7, 'rgba(51, 65, 85, 0.04)');
    shadowGrad.addColorStop(1, 'rgba(51, 65, 85, 0)');
    context.fillStyle = shadowGrad;
    context.beginPath();
    context.ellipse(centerPt.x, centerPt.y, shadowRadX, shadowRadY, 0, 0, Math.PI * 2);
    context.fill();

    // 2. Offscreen / Temp Canvas for the Blender Ground Plane with smooth circular radial falloff mask
    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = w;
    tempCanvas.height = h;
    const tCtx = tempCanvas.getContext('2d');

    // Minor Grid Lines (0.2m increments)
    tCtx.lineWidth = 0.8;
    for (let c = -gridLimit; c <= gridLimit + 0.001; c += 0.2) {
      if (Math.abs(c % 1.0) < 0.05 || Math.abs(c % 1.0 - 1.0) < 0.05) continue; // Skip majors
      tCtx.strokeStyle = 'rgba(148, 163, 184, 0.22)';

      // Along Z (parallel to Z axis)
      const pZ1 = projectPoint({ x: c, y: gridY, z: -gridLimit }, w, h, scale, rX, rY, pX, pY);
      const pZ2 = projectPoint({ x: c, y: gridY, z: gridLimit }, w, h, scale, rX, rY, pX, pY);
      tCtx.beginPath();
      tCtx.moveTo(pZ1.x, pZ1.y);
      tCtx.lineTo(pZ2.x, pZ2.y);
      tCtx.stroke();

      // Along X (parallel to X axis)
      const pX1 = projectPoint({ x: -gridLimit, y: gridY, z: c }, w, h, scale, rX, rY, pX, pY);
      const pX2 = projectPoint({ x: gridLimit, y: gridY, z: c }, w, h, scale, rX, rY, pX, pY);
      tCtx.beginPath();
      tCtx.moveTo(pX1.x, pX1.y);
      tCtx.lineTo(pX2.x, pX2.y);
      tCtx.stroke();
    }

    // Major Grid Lines (1.0m primary subdivisions)
    tCtx.lineWidth = 1.1;
    for (let m = -gridLimit; m <= gridLimit + 0.001; m += 1.0) {
      if (Math.abs(m) < 0.05) continue; // Skip origin primary axes
      tCtx.strokeStyle = 'rgba(100, 116, 139, 0.45)';

      // Parallel to Z
      const pZ1 = projectPoint({ x: m, y: gridY, z: -gridLimit }, w, h, scale, rX, rY, pX, pY);
      const pZ2 = projectPoint({ x: m, y: gridY, z: gridLimit }, w, h, scale, rX, rY, pX, pY);
      tCtx.beginPath();
      tCtx.moveTo(pZ1.x, pZ1.y);
      tCtx.lineTo(pZ2.x, pZ2.y);
      tCtx.stroke();

      // Parallel to X
      const pX1 = projectPoint({ x: -gridLimit, y: gridY, z: m }, w, h, scale, rX, rY, pX, pY);
      const pX2 = projectPoint({ x: gridLimit, y: gridY, z: m }, w, h, scale, rX, rY, pX, pY);
      tCtx.beginPath();
      tCtx.moveTo(pX1.x, pX1.y);
      tCtx.lineTo(pX2.x, pX2.y);
      tCtx.stroke();
    }

    // 3. Signature Blender Coordinate Axes:
    // Red X-Axis (#e05353) running along world X across the floor plane
    const xStart = projectPoint({ x: -gridLimit, y: gridY, z: 0 }, w, h, scale, rX, rY, pX, pY);
    const xEnd = projectPoint({ x: gridLimit, y: gridY, z: 0 }, w, h, scale, rX, rY, pX, pY);
    tCtx.strokeStyle = '#e05353';
    tCtx.lineWidth = 2.0;
    tCtx.beginPath();
    tCtx.moveTo(xStart.x, xStart.y);
    tCtx.lineTo(xEnd.x, xEnd.y);
    tCtx.stroke();

    // Green Y/Depth Ground Axis (#43a047 / Blender green) along world Z ground line
    const yStart = projectPoint({ x: 0, y: gridY, z: -gridLimit }, w, h, scale, rX, rY, pX, pY);
    const yEnd = projectPoint({ x: 0, y: gridY, z: gridLimit }, w, h, scale, rX, rY, pX, pY);
    tCtx.strokeStyle = '#43a047';
    tCtx.lineWidth = 2.0;
    tCtx.beginPath();
    tCtx.moveTo(yStart.x, yStart.y);
    tCtx.lineTo(yEnd.x, yEnd.y);
    tCtx.stroke();

    // 4. Apply Blender's signature Radial Circular Gradient Falloff (Destination-In fade)
    tCtx.globalCompositeOperation = 'destination-in';
    const maxRadius = Math.max(w, h) * 0.55;
    const fadeGrad = tCtx.createRadialGradient(centerPt.x, centerPt.y, maxRadius * 0.12, centerPt.x, centerPt.y, maxRadius);
    fadeGrad.addColorStop(0, 'rgba(0, 0, 0, 1)');
    fadeGrad.addColorStop(0.55, 'rgba(0, 0, 0, 0.85)');
    fadeGrad.addColorStop(0.82, 'rgba(0, 0, 0, 0.35)');
    fadeGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    tCtx.fillStyle = fadeGrad;
    tCtx.fillRect(0, 0, w, h);

    // Blit masked floor grid onto main context
    context.drawImage(tempCanvas, 0, 0);

    // 5. Blender 3D Cursor / Center Origin Target indicator at (0, 0, 0)
    context.save();
    context.strokeStyle = '#dc2626';
    context.lineWidth = 1.2;
    context.beginPath();
    context.arc(centerPt.x, centerPt.y, 7, 0, Math.PI * 2);
    context.stroke();

    // Dashed inner crosshair ring styling
    context.strokeStyle = '#ffffff';
    context.setLineDash([2, 2]);
    context.lineWidth = 1;
    context.beginPath();
    context.arc(centerPt.x, centerPt.y, 7, 0, Math.PI * 2);
    context.stroke();
    context.setLineDash([]);

    // Central origin dot
    context.fillStyle = '#ffffff';
    context.beginPath();
    context.arc(centerPt.x, centerPt.y, 2.5, 0, Math.PI * 2);
    context.fill();
    context.strokeStyle = '#111318';
    context.lineWidth = 1;
    context.stroke();
    context.restore();

    context.restore();
  }

  // Draw 3D Orientation Mini Gizmo Compass (Monochrome Minimalist)
  function drawGizmoCompass() {
    const w = gizmoCanvas.width;
    const h = gizmoCanvas.height;
    gizmoCtx.clearRect(0, 0, w, h);

    const radX = (rotX * Math.PI) / 180;
    const radY = (rotY * Math.PI) / 180;
    const len = 24;

    const axes = [
      { name: 'X', color: '#111318', dir: { x: 1, y: 0, z: 0 } },
      { name: 'Y', color: '#475569', dir: { x: 0, y: -1, z: 0 } },
      { name: 'Z', color: '#94a3b8', dir: { x: 0, y: 0, z: 1 } }
    ];

    const cx = w / 2;
    const cy = h / 2;

    const projAxes = axes.map(axis => {
      const cosY = Math.cos(radY);
      const sinY = Math.sin(radY);
      const x1 = axis.dir.x * cosY - axis.dir.z * sinY;
      const z1 = axis.dir.x * sinY + axis.dir.z * cosY;

      const cosX = Math.cos(radX);
      const sinX = Math.sin(radX);
      const y2 = axis.dir.y * cosX - z1 * sinX;
      const z2 = axis.dir.y * sinX + z1 * cosX;

      return {
        name: axis.name,
        color: axis.color,
        px: cx + x1 * len,
        py: cy + y2 * len,
        depth: z2
      };
    });

    projAxes.sort((a, b) => a.depth - b.depth);

    gizmoCtx.beginPath();
    gizmoCtx.arc(cx, cy, 3, 0, Math.PI * 2);
    gizmoCtx.fillStyle = '#111318';
    gizmoCtx.fill();

    projAxes.forEach(ax => {
      gizmoCtx.strokeStyle = ax.color;
      gizmoCtx.lineWidth = 2;
      gizmoCtx.lineCap = 'round';
      gizmoCtx.beginPath();
      gizmoCtx.moveTo(cx, cy);
      gizmoCtx.lineTo(ax.px, ax.py);
      gizmoCtx.stroke();

      gizmoCtx.fillStyle = ax.color;
      gizmoCtx.beginPath();
      gizmoCtx.arc(ax.px, ax.py, 5.5, 0, Math.PI * 2);
      gizmoCtx.fill();

      gizmoCtx.fillStyle = '#ffffff';
      gizmoCtx.font = 'bold 7px JetBrains Mono';
      gizmoCtx.textAlign = 'center';
      gizmoCtx.textBaseline = 'middle';
      gizmoCtx.fillText(ax.name, ax.px, ax.py);
    });
  }

  // Draw Material Sphere Thumbnail in tab 2
  function drawMaterialBall() {
    const w = matBallCanvas.width;
    const h = matBallCanvas.height;
    matBallCtx.clearRect(0, 0, w, h);

    const grad = matBallCtx.createRadialGradient(w * 0.35, h * 0.3, 2, w * 0.5, h * 0.5, w * 0.5);
    grad.addColorStop(0, '#ffffff');
    grad.addColorStop(0.2, baseColor);
    grad.addColorStop(0.8, '#1e293b');
    grad.addColorStop(1, '#090d16');

    matBallCtx.fillStyle = grad;
    matBallCtx.beginPath();
    matBallCtx.arc(w / 2, h / 2, w / 2 - 2, 0, Math.PI * 2);
    matBallCtx.fill();

    const specGrad = matBallCtx.createRadialGradient(w * 0.35, h * 0.28, 1, w * 0.35, h * 0.28, 14 * (1.1 - roughness));
    specGrad.addColorStop(0, `rgba(255, 255, 255, ${0.9 * (1.1 - roughness)})`);
    specGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
    matBallCtx.fillStyle = specGrad;
    matBallCtx.beginPath();
    matBallCtx.arc(w * 0.35, h * 0.28, 12, 0, Math.PI * 2);
    matBallCtx.fill();
  }

  // Main Render Loop for Central Viewport
  function renderViewport() {
    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    ctx.clearRect(0, 0, width, height);

    // Studio Background subtle radial wash
    const bgGrad = ctx.createRadialGradient(width / 2, height / 2, 50, width / 2, height / 2, Math.max(width, height) * 0.7);
    bgGrad.addColorStop(0, '#f8fafc');
    bgGrad.addColorStop(1, '#e5e9f0');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, width, height);

    const baseUnitScale = Math.min(width, height) * 0.26 * zoom;

    if (overlaysVisible) {
      drawPerspectiveGrid(ctx, width, height, rotX, rotY, baseUnitScale, panX, panY);
    }

    const projectedVertices = vertices.map(v =>
      projectPoint(v, width, height, baseUnitScale, rotX, rotY, panX, panY)
    );

    const sortedPolys = polygons.map(poly => {
      let sumZ = 0;
      poly.indices.forEach(idx => {
        sumZ += projectedVertices[idx].z;
      });
      const avgZ = sumZ / poly.indices.length;

      const p0 = projectedVertices[poly.indices[0]];
      const p1 = projectedVertices[poly.indices[1]];
      const p2 = projectedVertices[poly.indices[2]];

      const vA = { x: p1.rawX - p0.rawX, y: p1.rawY - p0.rawY, z: p1.rawZ - p0.rawZ };
      const vB = { x: p2.rawX - p0.rawX, y: p2.rawY - p0.rawY, z: p2.rawZ - p0.rawZ };
      let nx = vA.y * vB.z - vA.z * vB.y;
      let ny = vA.z * vB.x - vA.x * vB.z;
      let nz = vA.x * vB.y - vA.y * vB.x;
      const mag = Math.sqrt(nx * nx + ny * ny + nz * nz) || 1;
      nx /= mag;
      ny /= mag;
      nz /= mag;

      const lRad = (lightAngle * Math.PI) / 180;
      const lx = Math.cos(lRad);
      const ly = -0.5;
      const lz = Math.sin(lRad);

      const dot = Math.max(0.18, -(nx * lx + ny * ly + nz * lz));

      return {
        ...poly,
        avgZ,
        normal: { x: nx, y: ny, z: nz },
        lightIntensity: dot
      };
    });

    sortedPolys.sort((a, b) => b.avgZ - a.avgZ);

    sortedPolys.forEach(poly => {
      if (!partVisibility[poly.part]) return;

      ctx.beginPath();
      poly.indices.forEach((vIdx, i) => {
        const pt = projectedVertices[vIdx];
        if (i === 0) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      });
      ctx.closePath();

      // MONOCHROME SHADER RENDERING
      if (currentPass === 'combined') {
        if (poly.isGlass) {
          ctx.fillStyle = `rgba(71, 85, 105, ${0.35 * (0.8 + emission * 0.4)})`;
        } else if (poly.isBarrel) {
          const bVal = Math.floor(40 + poly.lightIntensity * 60);
          ctx.fillStyle = `rgb(${bVal}, ${bVal}, ${bVal})`;
        } else {
          const r = parseInt(baseColor.slice(1, 3), 16);
          const g = parseInt(baseColor.slice(3, 5), 16);
          const b = parseInt(baseColor.slice(5, 7), 16);

          const spec = Math.pow(poly.lightIntensity, 12 * (1.1 - roughness)) * metallic * 180;
          const finalR = Math.min(255, Math.floor(r * poly.lightIntensity + spec));
          const finalG = Math.min(255, Math.floor(g * poly.lightIntensity + spec));
          const finalB = Math.min(255, Math.floor(b * poly.lightIntensity + spec));

          ctx.fillStyle = `rgb(${finalR}, ${finalG}, ${finalB})`;
        }
        ctx.fill();

      } else if (currentPass === 'albedo') {
        if (poly.isGlass) ctx.fillStyle = '#94a3b8';
        else if (poly.isBarrel) ctx.fillStyle = '#334155';
        else ctx.fillStyle = baseColor;
        ctx.fill();

      } else if (currentPass === 'normal') {
        // Monochrome Normal map inspection
        const monoNorm = Math.floor(((poly.normal.x + poly.normal.y + poly.normal.z) / 3 * 0.5 + 0.5) * 255);
        ctx.fillStyle = `rgb(${monoNorm}, ${monoNorm}, ${monoNorm})`;
        ctx.fill();

      } else if (currentPass === 'roughness') {
        const val = Math.floor(roughness * 255);
        ctx.fillStyle = `rgb(${val}, ${val}, ${val})`;
        ctx.fill();

      } else if (currentPass === 'matcap') {
        const clayIntensity = Math.floor(80 + poly.lightIntensity * 140);
        ctx.fillStyle = `rgb(${clayIntensity}, ${clayIntensity}, ${clayIntensity})`;
        ctx.fill();

      } else if (currentPass === 'xray') {
        ctx.fillStyle = 'rgba(17, 19, 24, 0.1)';
        ctx.fill();

      } else if (currentPass === 'wireframe') {
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }

      // Wireframe Outline Overlays
      if (overlaysVisible || currentPass === 'wireframe') {
        const wireAlpha = currentPass === 'wireframe' ? 1.0 : wireOpacity;
        if (poly.isGlass) {
          ctx.strokeStyle = `rgba(100, 116, 139, ${wireAlpha})`;
        } else if (poly.part === 'chassis') {
          ctx.strokeStyle = `rgba(17, 19, 24, ${wireAlpha})`;
        } else {
          ctx.strokeStyle = `rgba(71, 85, 105, ${wireAlpha * 0.8})`;
        }
        ctx.lineWidth = currentPass === 'wireframe' ? 1.2 : 0.9;
        ctx.stroke();
      }
    });

    // Vertex Nodes & Center Gizmo
    if (overlaysVisible) {
      projectedVertices.forEach(v => {
        if (!partVisibility[v.part]) return;
        ctx.fillStyle = '#111318';
        ctx.beginPath();
        ctx.arc(v.x, v.y, 1.75, 0, Math.PI * 2);
        ctx.fill();
      });

      const origin = projectPoint({ x: 0, y: 0.2, z: 0 }, width, height, baseUnitScale, rotX, rotY, panX, panY);
      
      // X-Axis (Dark Charcoal)
      const gX = projectPoint({ x: 0.4, y: 0.2, z: 0 }, width, height, baseUnitScale, rotX, rotY, panX, panY);
      ctx.strokeStyle = '#111318';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(origin.x, origin.y);
      ctx.lineTo(gX.x, gX.y);
      ctx.stroke();

      // Y-Axis (Medium Slate)
      const gY = projectPoint({ x: 0, y: -0.2, z: 0 }, width, height, baseUnitScale, rotX, rotY, panX, panY);
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(origin.x, origin.y);
      ctx.lineTo(gY.x, gY.y);
      ctx.stroke();

      // Z-Axis (Light Slate)
      const gZ = projectPoint({ x: 0, y: 0.2, z: 0.4 }, width, height, baseUnitScale, rotX, rotY, panX, panY);
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(origin.x, origin.y);
      ctx.lineTo(gZ.x, gZ.y);
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#111318';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(origin.x, origin.y, 3.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }

    orbitReadout.textContent = `Pitch: ${Math.round(rotX)}° · Yaw: ${Math.round(rotY)}°`;
    rotXDisplay.textContent = `${Math.round(rotX)}°`;
    rotYDisplay.textContent = `${Math.round(rotY)}°`;
    rotZDisplay.textContent = `${Math.round(lightAngle)}°`;

    drawGizmoCompass();
  }

  function animationLoop(timestamp) {
    if (isAutoSpin && !isDragging) {
      rotY = (rotY + 0.35) % 360;
    }

    renderViewport();

    frameCount++;
    const now = performance.now();
    if (now - lastFrameTime >= 500) {
      fps = ((frameCount * 1000) / (now - lastFrameTime)).toFixed(1);
      fpsDisplay.textContent = fps;
      frameCount = 0;
      lastFrameTime = now;
    }

    requestAnimationFrame(animationLoop);
  }
  requestAnimationFrame(animationLoop);

  // Mouse Handlers
  canvas.addEventListener('mousedown', e => {
    isDragging = true;
    lastMouseX = e.clientX;
    lastMouseY = e.clientY;
    dragMode = (e.button === 2 || e.shiftKey) ? 'pan' : 'orbit';
  });

  window.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    cursorPosDisplay.textContent = `X: ${(e.clientX - rect.left).toFixed(0)} Y: ${(e.clientY - rect.top).toFixed(0)}`;

    if (!isDragging) return;

    const deltaX = e.clientX - lastMouseX;
    const deltaY = e.clientY - lastMouseY;
    lastMouseX = e.clientX;
    lastMouseY = e.clientY;

    if (dragMode === 'orbit') {
      rotY = (rotY + deltaX * 0.6) % 360;
      rotX = Math.max(-85, Math.min(85, rotX - deltaY * 0.6));
    } else if (dragMode === 'pan') {
      panX += deltaX;
      panY += deltaY;
    }
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
  });

  canvas.addEventListener('wheel', e => {
    e.preventDefault();
    const zoomDelta = e.deltaY < 0 ? 1.08 : 0.92;
    zoom = Math.max(0.3, Math.min(3.5, zoom * zoomDelta));
    document.getElementById('hud-fov').textContent = `Zoom: ${zoom.toFixed(2)}x`;
  }, { passive: false });

  canvas.addEventListener('contextmenu', e => e.preventDefault());

  // Shading Pass Buttons
  const passButtons = document.querySelectorAll('.pass-btn');
  const footerPassStatus = document.getElementById('footer-pass-status');

  passButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      passButtons.forEach(b => {
        b.classList.remove('bg-[#111318]', 'text-white', 'shadow-sm');
        b.classList.add('text-on-surface-variant');
      });
      btn.classList.add('bg-[#111318]', 'text-white', 'shadow-sm');
      btn.classList.remove('text-on-surface-variant');

      currentPass = btn.dataset.pass;
      footerPassStatus.textContent = btn.title || currentPass.toUpperCase();
    });
  });

  // Turntable Auto-Spin Toggle
  const btnAutoSpin = document.getElementById('btn-autospin');
  const autospinIcon = document.getElementById('autospin-icon');
  const autospinText = document.getElementById('autospin-text');

  btnAutoSpin.addEventListener('click', () => {
    isAutoSpin = !isAutoSpin;
    if (isAutoSpin) {
      btnAutoSpin.classList.add('text-black', 'border-black');
      autospinIcon.classList.add('text-black');
      autospinText.textContent = 'Spinning';
    } else {
      btnAutoSpin.classList.remove('text-black', 'border-black');
      autospinIcon.classList.remove('text-black');
      autospinText.textContent = 'Paused';
    }
  });

  // Overlays Toggle
  const btnOverlays = document.getElementById('btn-toggle-overlays');
  btnOverlays.addEventListener('click', () => {
    overlaysVisible = !overlaysVisible;
    btnOverlays.classList.toggle('text-black', overlaysVisible);
    btnOverlays.classList.toggle('border-black', overlaysVisible);
  });

  // Viewport Sliders
  const lightSlider = document.getElementById('light-angle-slider');
  const lightVal = document.getElementById('light-angle-val');
  lightSlider.addEventListener('input', e => {
    lightAngle = parseFloat(e.target.value);
    lightVal.textContent = `${lightAngle}°`;
  });

  const wireSlider = document.getElementById('wire-opacity-slider');
  const wireVal = document.getElementById('wire-opacity-val');
  wireSlider.addEventListener('input', e => {
    wireOpacity = parseFloat(e.target.value) / 100;
    wireVal.textContent = `${e.target.value}%`;
  });

  // Gizmo Compass Axis Alignment
  gizmoCanvas.addEventListener('click', e => {
    const rect = gizmoCanvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left - gizmoCanvas.width / 2;
    const clickY = e.clientY - rect.top - gizmoCanvas.height / 2;

    if (Math.abs(clickX) > Math.abs(clickY)) {
      rotX = 0;
      rotY = clickX > 0 ? 90 : -90;
    } else {
      rotX = clickY < 0 ? 90 : 0;
      rotY = 0;
    }
    document.getElementById('view-perspective-name').textContent = 'ORTHOGRAPHIC SNAP';
  });

  document.getElementById('btn-zoom-in').addEventListener('click', () => {
    zoom = Math.min(3.5, zoom * 1.15);
  });
  document.getElementById('btn-zoom-out').addEventListener('click', () => {
    zoom = Math.max(0.3, zoom * 0.85);
  });
  document.getElementById('btn-reset-cam').addEventListener('click', () => {
    rotX = 18;
    rotY = 35;
    zoom = 1.0;
    panX = 0;
    panY = 0;
    document.getElementById('view-perspective-name').textContent = 'PERSPECTIVE CAMERA';
  });

  // Quad-View Split View Toggle
  const toggleQuadBtn = document.getElementById('toggle-quadview');
  const singleView = document.getElementById('single-viewport');
  const quadGrid = document.getElementById('quad-viewport-grid');
  const quadLabel = document.getElementById('quadview-label');
  let isQuad = false;

  toggleQuadBtn.addEventListener('click', () => {
    isQuad = !isQuad;
    if (isQuad) {
      singleView.classList.add('hidden');
      quadGrid.classList.remove('hidden');
      quadLabel.textContent = '4-View';
      toggleQuadBtn.classList.add('bg-[#111318]', 'text-white');
      renderQuadViews();
    } else {
      singleView.classList.remove('hidden');
      quadGrid.classList.add('hidden');
      quadLabel.textContent = 'Single';
      toggleQuadBtn.classList.remove('bg-[#111318]', 'text-white');
      resizeCanvas();
    }
  });

  function renderQuadViews() {
    const quadCanvases = [
      { id: 'quad-canvas-top', rx: 90, ry: 0 },
      { id: 'quad-canvas-front', rx: 0, ry: 0 },
      { id: 'quad-canvas-right', rx: 0, ry: 90 },
      { id: 'quad-canvas-persp', rx: rotX, ry: rotY }
    ];

    quadCanvases.forEach(cfg => {
      const qCanv = document.getElementById(cfg.id);
      if (!qCanv) return;
      qCanv.width = qCanv.clientWidth * (window.devicePixelRatio || 1);
      qCanv.height = qCanv.clientHeight * (window.devicePixelRatio || 1);
      const qCtx = qCanv.getContext('2d');
      qCtx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);

      const qw = qCanv.clientWidth;
      const qh = qCanv.clientHeight;
      const qScale = Math.min(qw, qh) * 0.28;

      // Clear with soft studio gray
      qCtx.fillStyle = '#f8fafc';
      qCtx.fillRect(0, 0, qw, qh);

      drawPerspectiveGrid(qCtx, qw, qh, cfg.rx, cfg.ry, qScale, 0, 0);

      const qProj = vertices.map(v => projectPoint(v, qw, qh, qScale, cfg.rx, cfg.ry, 0, 0));
      polygons.forEach(poly => {
        qCtx.beginPath();
        poly.indices.forEach((idx, i) => {
          const pt = qProj[idx];
          if (i === 0) qCtx.moveTo(pt.x, pt.y);
          else qCtx.lineTo(pt.x, pt.y);
        });
        qCtx.closePath();
        qCtx.fillStyle = '#e2e8f0';
        qCtx.fill();
        qCtx.strokeStyle = '#111318';
        qCtx.lineWidth = 0.8;
        qCtx.stroke();
      });
    });
  }

  // Right Panel Tab Switcher
  const inspectorTabs = document.querySelectorAll('.inspector-tab');
  const tabPanes = document.querySelectorAll('.tab-pane');

  inspectorTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      inspectorTabs.forEach(t => {
        t.classList.remove('bg-[#111318]', 'text-white', 'shadow-sm');
        t.classList.add('text-on-surface-variant');
      });
      tab.classList.add('bg-[#111318]', 'text-white', 'shadow-sm');
      tab.classList.remove('text-on-surface-variant');

      const targetId = tab.dataset.tab;
      tabPanes.forEach(pane => {
        pane.classList.add('hidden');
      });
      document.getElementById(targetId).classList.remove('hidden');

      if (targetId === 'tab-material') {
        drawMaterialBall();
      }
    });
  });

  // Right Panel Collapse Toggle
  const rightPanel = document.getElementById('right-inspector');
  const toggleRightBtn = document.getElementById('toggle-right-panel');
  let panelCollapsed = false;

  toggleRightBtn.addEventListener('click', () => {
    panelCollapsed = !panelCollapsed;
    if (panelCollapsed) {
      rightPanel.classList.add('w-0', 'border-l-0', 'p-0');
      rightPanel.classList.remove('w-80', 'md:w-84', 'xl:w-96');
    } else {
      rightPanel.classList.remove('w-0', 'border-l-0', 'p-0');
      rightPanel.classList.add('w-80', 'md:w-84', 'xl:w-96');
    }
    setTimeout(resizeCanvas, 320);
  });

  // Outliner Part Visibility
  const treeNodes = document.querySelectorAll('.tree-node');
  treeNodes.forEach(node => {
    const part = node.dataset.part;
    const visBtn = node.querySelector('.node-vis-btn');
    const visIcon = visBtn.querySelector('.material-symbols-outlined');

    visBtn.addEventListener('click', e => {
      e.stopPropagation();
      partVisibility[part] = !partVisibility[part];
      if (partVisibility[part]) {
        visIcon.textContent = 'visibility';
        visIcon.classList.remove('text-outline');
        node.classList.remove('opacity-40');
      } else {
        visIcon.textContent = 'visibility_off';
        visIcon.classList.add('text-outline');
        node.classList.add('opacity-40');
      }
    });

    node.addEventListener('click', () => {
      treeNodes.forEach(n => {
        n.classList.remove('bg-white', 'border-[#111318]', 'shadow-sm');
        n.classList.add('border-transparent');
      });
      node.classList.add('bg-white', 'border-[#111318]', 'shadow-sm');
      node.classList.remove('border-transparent');
      document.getElementById('active-mesh-name').textContent = node.querySelector('span:nth-child(2)').textContent;
    });
  });

  // Material Shader Sliders
  const colorPicker = document.getElementById('slider-base-color');
  const colorHex = document.getElementById('color-hex-val');
  colorPicker.addEventListener('input', e => {
    baseColor = e.target.value;
    colorHex.textContent = baseColor;
    drawMaterialBall();
  });

  document.querySelectorAll('.preset-color').forEach(btn => {
    btn.addEventListener('click', () => {
      baseColor = btn.dataset.color;
      colorPicker.value = baseColor;
      colorHex.textContent = baseColor;
      drawMaterialBall();
    });
  });

  const metallicSlider = document.getElementById('slider-metallic');
  const metallicVal = document.getElementById('val-metallic');
  metallicSlider.addEventListener('input', e => {
    metallic = parseFloat(e.target.value) / 100;
    metallicVal.textContent = metallic.toFixed(2);
    drawMaterialBall();
  });

  const roughnessSlider = document.getElementById('slider-roughness');
  const roughnessVal = document.getElementById('val-roughness');
  roughnessSlider.addEventListener('input', e => {
    roughness = parseFloat(e.target.value) / 100;
    roughnessVal.textContent = roughness.toFixed(2);
    drawMaterialBall();
  });

  const emissionSlider = document.getElementById('slider-emission');
  const emissionVal = document.getElementById('val-emission');
  emissionSlider.addEventListener('input', e => {
    emission = parseFloat(e.target.value) / 100;
    emissionVal.textContent = emission.toFixed(2);
  });

  drawMaterialBall();
});
</script>
